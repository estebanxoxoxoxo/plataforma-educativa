{
  "name": "innerith-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch --env-file=server/.env server/src/index.ts",
    "import:smarty": "node server/scripts/import-smarty.mjs",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "dompurify": "^3.4.16",
    "jsdom": "^30.1.1",
    "minisearch": "^7.2.0",
    "openai": "^7.27.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
