{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "innerith",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "innerith-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:web",
        "--",
        "--port",
        "5188",
        "--strictPort"
      ],
      "port": 5188
    },
    {
      "name": "innerith-api",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
        "watch",
        "--env-file=server/.env",
        "server/src/index.ts"
      ],
      "port": 8787
    }
  ]
}
