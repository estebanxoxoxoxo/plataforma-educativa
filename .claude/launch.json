{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "innerith",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:web",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "smarty-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:web",
        "--",
        "--port",
        "5188",
        "--strictPort"
      ],
      "port": 5188
    },
    {
      "name": "smarty-api",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
        "watch",
        "--env-file=server/.env",
        "server/src/index.ts"
      ],
      "port": 8787
    },
    {
      "name": "route-lab",
      "runtimeExecutable": "route-lab/.venv/bin/python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "server:app",
        "--port",
        "5203",
        "--app-dir",
        "route-lab"
      ],
      "port": 5203
    },
    {
      "name": "route-lab-alt",
      "runtimeExecutable": "route-lab/.venv/bin/python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "server:app",
        "--port",
        "5204",
        "--app-dir",
        "route-lab"
      ],
      "port": 5204
    }
  ]
}
